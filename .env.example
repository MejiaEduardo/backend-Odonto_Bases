# =====================================================================
#  Plantilla de variables de entorno
# =====================================================================
#
#  Copiar este archivo como .env EN ESTA MISMA CARPETA (la que tiene el
#  package.json) y rellenar los valores:
#
#      copy .env.example .env
#
#  El .env está en .gitignore: no se sube al repositorio. Cada quien crea
#  el suyo.
#
#  OJO: la versión anterior de esta plantilla decía DATABASE_URL, pero el
#  código NO usa esa variable. src/database/db.ts arma la conexión con las
#  cinco DB_* de abajo. Con DATABASE_URL el backend arranca y se cae en la
#  primera consulta con ECONNREFUSED o "password authentication failed".
# =====================================================================

# --- Base de datos (PostgreSQL en Docker) ---
# Estos valores coinciden con docker-compose.yml: si usan ese archivo,
# funcionan tal cual están.
DB_HOST=localhost
# 5433, NO 5432: el 5432 suele estar ocupado por el PostgreSQL instalado
# en Windows. docker-compose publica el contenedor en el 5433.
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=odonto123
DB_NAME=odontologia

# --- Servidor ---
PORT=3000

# --- JWT ---
# Cualquier cadena larga sirve. Si falta, el código cae a 'secreto'.
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# --- Google OAuth (OPCIONAL) ---
# Sin estas dos, el botón de Google no se muestra en el login y el
# proyecto arranca igual. Ver GUIA_LOGIN_GOOGLE.md para obtenerlas.
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# A dónde vuelve el usuario cuando Google termina el flujo
FRONTEND_URL=http://localhost:5173

# --- Firebase Storage (OPCIONAL) ---
# Solo hace falta para subir archivos adjuntos a los expedientes. Si no
# están, el backend arranca igual y avisa por consola; únicamente falla
# esa función concreta.
# El JSON de la cuenta de servicio va en UNA SOLA LÍNEA.
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_STORAGE_BUCKET=
